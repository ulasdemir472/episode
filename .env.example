EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# Server-only secrets. Add these with `supabase secrets set`; never prefix them
# with EXPO_PUBLIC and never bundle them into the mobile application.
TMDB_ACCESS_TOKEN=your_tmdb_v4_read_access_token
OMDB_API_KEY=your_omdb_api_key

# Server-only Grafana Cloud configuration. Leave unset until the Cloud account
# is ready. Copy the OTLP base endpoint and Authorization header from your stack.
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-YOUR_REGION.grafana.net/otlp
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic YOUR_BASE64_CREDENTIALS
# MONITORING_ENVIRONMENT=production
# MONITORING_TRACE_SAMPLE_RATE=0.1
