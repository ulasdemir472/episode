{
  "expo": {
    "name": "Episode",
    "slug": "episode",
    "scheme": "episode",
    "version": "1.0.1",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.episodeapp.mobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.episodeapp.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#07070A"
      },
      "permissions": [
        "POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Episode profil fotoğrafı seçebilmen için fotoğraf arşivine erişim ister."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#FF5A47",
          "defaultChannel": "new-episodes"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "06b78221-b54d-415e-b09f-1b1a654393cf"
      }
    },
    "updates": {
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/06b78221-b54d-415e-b09f-1b1a654393cf"
    },
    "owner": "ulasdemir472"
  }
}
