{
  "name": "episode",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "expo": {
    "autolinking": {
      "ios": {
        "buildFromSource": [
          "react-native-reanimated",
          "react-native-worklets"
        ]
      }
    }
  },
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:business": "jest src/store src/features/community src/features/sync --runInBand",
    "test:performance": "jest src/performance --runInBand",
    "test:coverage": "jest --coverage --runInBand",
    "test:database": "node scripts/test-database.mjs",
    "test:deployment": "node --test scripts/__tests__/*.test.mjs",
    "typecheck:edge": "npx --yes deno@2.9.6 check --config supabase/functions/deno.json --frozen supabase/functions/catalog-api/index.ts supabase/functions/notification-worker/index.ts supabase/functions/delete-account/index.ts",
    "test:edge": "npx --yes deno@2.9.6 test --config supabase/functions/deno.json --frozen supabase/functions/_tests",
    "validate": "npm run typecheck && npm run lint && npm test && npm run test:deployment",
    "validate:all": "npm run validate && npm run typecheck:edge && npm run test:edge && npm run test:database"
  },
  "dependencies": {
    "@expo/vector-icons": "latest",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.110.2",
    "@tanstack/react-query": "^5.90.0",
    "base64-arraybuffer": "^1.0.2",
    "expo": "~57.0.27",
    "expo-blur": "~57.0.3",
    "expo-constants": "~57.0.21",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image-picker": "~57.0.20",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.12",
    "expo-notifications": "~57.0.22",
    "expo-router": "~57.0.25",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.25",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@expo/dom-webview": "~57.0.1",
    "@expo/metro-runtime": "^57.0.16",
    "@expo/ngrok": "^4.1.3",
    "@testing-library/react-native": "latest",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.0",
    "babel-preset-expo": "latest",
    "eslint": "^9.38.0",
    "eslint-config-expo": "~57.0.2",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "typescript": "~6.0.3",
    "yaml": "2.9.1"
  }
}
