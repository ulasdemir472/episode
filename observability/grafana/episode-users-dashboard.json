  },
  "links": [
    {
      "title": "Kotalar ve Operasyon",
      "type": "link",
      "icon": "dashboard",
      "url": "/d/episode-ops-overview",
      "targetBlank": false,
      "includeVars": true,
      "keepTime": true
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(255, 120, 90, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "environment",
        "label": "Ortam",
        "type": "custom",
        "query": "production,local",
        "current": {
          "text": "production",
          "value": "production"
        },
        "options": [
          {
            "selected": true,
            "text": "production",
            "value": "production"
          },
          {
            "selected": false,
            "text": "local",
            "value": "local"
          }
        ],
        "includeAll": false,
        "multi": false,
        "hide": 0
      },
      {
        "name": "metrics",
        "label": "Metrikler",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "options": [],
        "refresh": 1,
        "includeAll": false,
        "multi": false,
        "hide": 0
      }
    ]
  },
