      "title": "Bugünkü özellik kullanımı · işlem adedi",
      "type": "bargauge",
      "gridPos": {
        "x": 14,
        "y": 11,
        "w": 10,
        "h": 8
      },
      "description": "Mantıksal kullanıcı etkileşimleri; retry ve sync tekrarları yeni işlem sayılmaz. Toplu bölüm işaretlemesi bir işlem, item_count ayrı ölçümdür.",
      "datasource": {
        "type": "prometheus",
        "uid": "${metrics}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(episode_user_events_today{environment=\"$environment\",event=\"search_submitted\"})",
          "legendFormat": "Arama",
          "instant": true,
          "range": false
        },
        {
          "refId": "B",
          "expr": "sum(episode_user_events_today{environment=\"$environment\",event=\"media_detail_opened\"})",
          "legendFormat": "İçerik detayı",
          "instant": true,
          "range": false
        },
        {
          "refId": "C",
          "expr": "sum(episode_user_events_today{environment=\"$environment\",event=\"library_item_added\"})",
          "legendFormat": "Kütüphaneye ekleme",
          "instant": true,
          "range": false
        },
        {
          "refId": "D",
          "expr": "sum(episode_user_events_today{environment=\"$environment\",event=\"episode_marked\"})",
          "legendFormat": "Bölüm işaretleme işlemi",
          "instant": true,
          "range": false
        },
        {
          "refId": "E",
          "expr": "sum(episode_user_events_today{environment=\"$environment\",event=\"comment_submitted\"})",
          "legendFormat": "Yorum gönderme",
          "instant": true,
          "range": false
        },
        {
          "refId": "F",
          "expr": "sum(episode_user_events_today{environment=\"$environment\",event=\"friend_request_sent\"})",
          "legendFormat": "Arkadaşlık isteği",
          "instant": true,
          "range": false
        },
        {
          "refId": "G",
          "expr": "sum(episode_user_events_today{environment=\"$environment\",event=\"watch_wheel_spun\"})",
          "legendFormat": "Watch-wheel",
          "instant": true,
          "range": false
        },
        {
          "refId": "H",
          "expr": "sum(episode_user_events_today{environment=\"$environment\",event=\"notification_opened\"})",
          "legendFormat": "Bildirim açma",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "Veri yok",
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "Veri yok",
                  "color": "gray",
                  "index": 0
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "nan",
                "result": {
                  "text": "Yeterli veri yok",
                  "color": "gray",
                  "index": 1
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "valueMode": "color"
      }
    },
