{
  "id": null,
  "uid": "episode-users-activity",
  "title": "Episode · Kullanıcılar ve Aktivite",
  "description": "Backend ve mobil JS bağlantıları repository’de hazırdır. Production için Cloud yapılandırması ve deployment gerekir. Local veriler sentetiktir.",
  "tags": [
    "episode",
    "users",
    "activity"
  ],
  "timezone": "Europe/Istanbul",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "5m",
