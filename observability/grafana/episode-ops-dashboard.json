{
  "id": null,
  "uid": "episode-ops-overview",
  "title": "Episode · Kotalar ve Operasyon",
  "description": "Backend ve mobil JS bağlantıları repository’de hazırdır. Production için Cloud yapılandırması ve deployment gerekir. Local veriler sentetiktir.",
  "tags": [
    "episode",
    "observability",
    "quota"
  ],
  "timezone": "Europe/Istanbul",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "5m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "1m",
      "5m",
      "15m",
      "30m",
      "1h"
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(255, 120, 90, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "environment",
        "label": "Ortam",
        "type": "custom",
        "query": "production,local",
        "current": {
          "text": "production",
          "value": "production"
        },
        "options": [
          {
            "selected": true,
            "text": "production",
            "value": "production"
          },
          {
            "selected": false,
            "text": "local",
            "value": "local"
          }
        ],
        "includeAll": false,
        "multi": false,
        "hide": 0
      },
      {
        "name": "metrics",
        "label": "Metrikler",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "options": [],
        "refresh": 1,
        "includeAll": false,
        "multi": false,
        "hide": 0
      },
      {
        "name": "logs",
        "label": "Loglar",
        "type": "datasource",
        "query": "loki",
        "current": {},
        "options": [],
        "refresh": 1,
        "includeAll": false,
        "multi": false,
        "hide": 0
      },
      {
        "name": "traces",
        "label": "Trace",
        "type": "datasource",
        "query": "tempo",
        "current": {},
        "options": [],
        "refresh": 1,
        "includeAll": false,
        "multi": false,
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "EPISODE / OPERASYON MERKEZİ",
      "type": "text",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "description": "",
      "transparent": false,
      "options": {
        "mode": "markdown",
        "content": "**Kotalar, günlük tüketim ve servis sağlığı.** `local` örnek veri, `production` gerçek backend. Veri gecikmesini Veri yaşı kartından kontrol et."
      }
    },
    {
      "id": 2,
      "title": "Katalog isteği · bugün",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 6,
        "h": 4
      },
      "description": "Sunucuya ulaşan katalog istekleri. Cihaz cache'inden karşılanan kullanıcı işlemlerini içermez.",
      "transparent": false,
      "datasource": {
        "type": "prometheus",
        "uid": "${metrics}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(episode_catalog_requests_today{environment=\"$environment\"})",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "locale",
          "decimals": 0,
          "noValue": "Veri yok",
          "color": {
            "mode": "fixed",
            "fixedColor": "#FF785A"
          },
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "Veri yok",
                  "color": "gray",
                  "index": 0
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "nan",
                "result": {
                  "text": "Yeterli veri yok",
                  "color": "gray",
                  "index": 1
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
