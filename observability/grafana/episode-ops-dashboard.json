    {
      "id": 12,
      "title": "Cache · güncel ve eski veri kullanımı",
      "type": "timeseries",
      "gridPos": {
        "x": 14,
        "y": 13,
        "w": 10,
        "h": 8
      },
      "description": "hit, miss, stale_limit ve stale_error birbirinden ayrılır; sınıflar karşılıklı dışlayıcıdır.",
      "transparent": false,
      "datasource": {
        "type": "prometheus",
        "uid": "${metrics}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (cache_result) (episode_catalog_cache_responses_today{environment=\"$environment\"})",
          "legendFormat": "{{cache_result}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
